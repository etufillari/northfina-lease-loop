// Database schema. Change it, then run `npm run db:migrate -- --name <what_changed>`.
// Never hand-write files in prisma/migrations/: the Prisma CLI generates them.
// SQLite has no enums here, so allowed values (category, condition, status) are
// checked with Zod in src/data/schemas.ts before anything is written.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One physical item that can be leased, returned, refurbished and leased again.
// Mirrors data/assets.json; `usage` is stored as two columns.
model Asset {
  id                 String   @id
  category           String // e_bike | laptop | farm_machine
  make               String
  model              String
  model_year         Int
  serial_number      String   @unique
  condition          String // new | like_new | good | fair | poor
  usage_unit         String // km | battery_cycles | engine_hours
  usage_value        Int
  previous_lives     Int
  status             String // available | reserved | returned
  ownerId            String?
  nextLifePriceCents Int?
  nextLifePricedOn   String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@index([category])
}

// Who changed what, and when. Written in the same transaction as the change
// (see src/server/audit.ts), so a change without an audit row cannot exist.
model AuditLog {
  id           Int      @id @default(autoincrement())
  created_at   DateTime @default(now())
  actor        String
  action       String // e.g. asset.status_changed
  entity_type  String // e.g. asset
  entity_id    String
  details_json String? // JSON text, e.g. {"from":"available","to":"reserved"}

  @@index([entity_type, entity_id])
  @@index([created_at])
}

// Immutable signing snapshot; later catalogue changes never update this row.
model Contract {
  invoices                Invoice[]
  quote                   Quote?                @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  id                      String                @id
  quoteId                 String?               @unique
  /// The initial offer's version and the version locked on the final signature. Null on legacy rows.
  quotedPriceListVersion  Int?
  lockedPriceListVersion  Int?
  actor                   String
  renterId                String?
  providerId              String?
  assetId                 String
  /// First day of the lease, chosen by the customer. On or after signedOn.
  startOn                 String
  endOn                   String
  signedOn                String
  /// Card 6: the company's signatory the contract was sent to; null when the renter signed.
  signatoryEmail          String?
  /// The day the signatory signed; the lease is active from then. Null while waiting.
  signatorySignedOn       String?
  /// Declared use at application time, retained for the return inspection; null for other items.
  usagePurpose            String?
  /// Price display preference only; never a VAT exemption.
  vatRegistered           Boolean?
  termMonths              Int
  downPaymentCents        Int
  listPriceCents          Int
  priceListVersion        Int
  priceSource             String                @default("price_list")
  coefficientVersion      Int
  coefficientId           String
  band                    String
  factor                  Float
  financedCents           Int
  monthlyNetCents         Int
  buyoutNetCents          Int
  /// Nullable for pre-discount agreements; a new signing stores the original quote.
  originalMonthlyNetCents Int?
  monthlyDiscountCents    Int                   @default(0)
  discountBps             Int                   @default(0)
  discountRuleId          String?
  discountRuleRevision    Int?
  lines                   ContractLine[]
  lifecycle               ContractLifecycle?
  document                ContractDocument?
  exitRequests            ExitRequest[]
  endTermChoice           EndTermChoice?
  lifeCompletions         AssetLifeCompletion[]

  @@index([assetId])
  @@index([renterId])
  @@index([providerId])
}

// Immutable server-calculated offer saved when a renter starts an application.
// `requestKey` makes a retry of that transition return the same quote row.
model Quote {
  id                       String    @id
  requestKey               String    @unique
  renterId                 String
  assetId                  String
  termMonths               Int
  downPaymentCents         Int
  startOn                  String
  quotedOn                 String
  priceSource              String
  priceListVersion         Int
  coefficientVersion       Int
  coefficientId            String
  band                     String
  factor                   Float
  listPriceCents           Int
  financedCents            Int
  monthlyNetCents          Int
  originalMonthlyNetCents  Int
  monthlyDiscountCents     Int
  discountBps              Int
  discountRuleId           String?
  discountRuleRevision     Int?
  buyoutNetCents           Int
  vatPercent               Float
  monthlyGrossCents        Int
  createdAt                DateTime  @default(now())
  contract                 Contract?

  @@index([renterId, assetId])
}

// Mock accounts are selected by username; lifecycle relationships use stable IDs.
model DemoUser {
  id                String  @id
  canonicalUsername String  @unique
  displayName       String
  moderator         Boolean @default(false)
}

// Financial line snapshots allow later bundles without rewriting existing prices.
model ContractLine {
  id                 String   @id
  contractId         String
  contract           Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  assetId            String
  listPriceCents     Int
  downPaymentCents   Int
  financedCents      Int
  monthlyNetCents    Int
  buyoutNetCents     Int
  priceListVersion   Int
  priceSource        String   @default("price_list")
  coefficientVersion Int
  coefficientId      String
  band               String
  factor             Float

  @@unique([contractId, assetId])
}

// Mutable operational state is separate from the signed financial snapshot.
model ContractLifecycle {
  contractId  String   @id
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  status      String   @default("active")
  actualEndOn String?
  revision    Int      @default(0)
}

model ContractDocument {
  contractId      String   @id
  contract        Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  locale          String
  templateVersion String
  generatedAt     String
  sha256          String
  bytes           Bytes
}

// Immutable rental invoice. A billing period can only be issued once per contract.
model Invoice {
  id          String   @id
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  period      Int
  invoiceDate String
  dueDate     String
  netCents    Int
  vatPercent  Float
  vatCents    Int
  grossCents  Int

  @@unique([contractId, period])
}

// ---------------------------------------------------------------------------
// Dealer side (issue #12): receiving a returned item and preparing its next life.
// Money is out of scope here: relisting keeps the asset's existing catalogue price.
// ---------------------------------------------------------------------------

// A demo provider (dealer) identity. Selecting one is a mock context switch, not login.
model Provider {
  id          String @id
  displayName String
}

// Current inventory ownership. Separate from ContractProvider, which is history: a provider
// keeps access to their past agreements after an item changes hands, but cannot manage it.
model AssetOwnership {
  assetId    String @id
  providerId String
  /// seed | transfer
  source     String

  @@index([providerId])
}

// The provider of a signed contract, captured in the signing transaction. Never changes.
model ContractProvider {
  contractId String @id
  providerId String
  assetId    String

  @@index([providerId])
}

// One physical return being prepared for its next life. The stage is derived from these
// facts (receipt, completion, inspection, work, relisting); no free status string is stored.
model ReturnIntake {
  id          String              @id
  assetId     String
  /// null only for a seed import of an item the data pack already marks returned.
  contractId  String?
  providerId  String
  /// receipt | seed_import
  source      String
  receivedOn  String?
  receivedBy  String?
  /// The old lease was finalized (received and its exclusive end reached); life counted once.
  completedOn String?
  relistedOn  String?
  relistedBy  String?
  /// Optimistic concurrency: every command must name the revision it was based on.
  revision    Int                 @default(0)
  inspections ReturnInspection[]
  work        RefurbishmentWork[]

  @@unique([contractId, assetId])
  @@index([providerId])
  @@index([assetId])
}

model WaitingListEntry {
  id                     String  @id
  category               String
  maxMonthlyNetRentCents Int
  minCondition           String
  preferredTermMonths    Int
  neededBy               String
  signedUpOn             String
  who                    String
  /// waiting | offered | matched | expired
  status                 String  @default("waiting")
  offeredAssetId         String? @unique
  offeredIntakeId        String?
  offeredOn              String?
  offerJson              String?
  /// The signed-in customer who joined from the app; null for the data pack's entries.
  participantId          String?
  /// The language the customer joined in, for the "Do you still want this?" message.
  locale                 String  @default("en")
  /// The day "Do you still want this?" was sent after needed-by passed; null when not asked
  /// (or answered "yes" with a new date). See src/domain/waiting-list-follow-up.ts.
  stillWantedAskedOn     String?
  /// The day the entry expired, and why: declined | no_reply. Null while open.
  expiredOn              String?
  expiredReason          String?

  @@index([participantId])
  @@index([status])
}

model ReturnInspection {
  id                String       @id
  intakeId          String
  intake            ReturnIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  inspectedOn       String
  actor             String
  conditionBefore   String
  condition         String
  usageBefore       Int
  usageValue        Int
  /// Engine hours since the last major service, when the provider knows it.
  hoursSinceService Int?
  createdAt         DateTime     @default(now())
}

// What the provider reports was actually done. The app performs no repair itself.
model RefurbishmentWork {
  id              String       @id
  intakeId        String
  intake          ReturnIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  actionId        String
  performedOn     String
  actor           String
  conditionBefore String
  conditionAfter  String
  usageBefore     Int
  usageAfter      Int
  createdAt       DateTime     @default(now())

  @@unique([intakeId, actionId])
}

// Nonpersonal life facts for asset history and circular-impact inputs (#14).
model AssetLifecycleEvent {
  id          Int      @id @default(autoincrement())
  assetId     String
  intakeId    String?
  contractId  String?
  /// received | life_completed | inspected | work_recorded | relisted
  type        String
  on          String
  actor       String
  detailsJson String?
  createdAt   DateTime @default(now())

  @@index([assetId])
}

// A confirmed exit freezes its calculation; later policies do not rewrite this quote.
model ExitRequest {
  id               String        @id
  contractId       String
  contract         Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  openContractId   String?       @unique
  renterId         String
  providerId       String
  kind             String
  status           String        @default("pending")
  requestedOn      String
  effectiveEndOn   String
  quoteJson        String
  revision         Int           @default(0)
  balancesReviewed Boolean       @default(false)
  reviewedBy       String?
  completedOn      String?
  completedBy      String?
  receipts         ExitReceipt[]

  @@index([contractId])
  @@index([status, effectiveEndOn])
}

model ExitReceipt {
  id         String      @id
  exitId     String
  exit       ExitRequest @relation(fields: [exitId], references: [id], onDelete: Cascade)
  assetId    String
  receivedOn String
  receivedBy String

  @@unique([exitId, assetId])
}

model EndTermChoice {
  contractId     String   @id
  contract       Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  kind           String
  requestedOn    String
  nomineeId      String?
  completedOn    String?
  nextContractId String?
  settlementJson String?
}

// Unique per physical life even when a contract contains several bundled assets.
model AssetLifeCompletion {
  id          String   @id
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  assetId     String
  kind        String
  completedOn String

  @@unique([contractId, assetId])
}

// One immediately published review per completed agreement and reviewer. User IDs
// are stable participant IDs, validated against the contract by the server service.
model Rating {
  id                String           @id
  contractId        String
  reviewerId        String
  subjectId         String
  direction         String // renter_to_provider | provider_to_renter
  stars             Int
  comment           String           @default("")
  currentRevision   Int              @default(1)
  visibility        String           @default("visible") // visible | hidden
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  revisions         RatingRevision[]
  moderationVersion Int              @default(0)
  reports           RatingReport[]

  @@unique([contractId, reviewerId])
  @@index([subjectId, direction, visibility])
}

// Immutable evidence for edits and later reports. Author edits append, never replace.
model RatingRevision {
  id        String               @id
  ratingId  String
  revision  Int
  stars     Int
  comment   String
  authorId  String
  createdAt DateTime             @default(now())
  rating    Rating               @relation(fields: [ratingId], references: [id], onDelete: Restrict)
  reports   RatingReport[]
  decisions ModerationDecision[]

  @@unique([ratingId, revision])
}

// Immutable submission retains the precise content the subject reported.
model RatingReport {
  id               String               @id
  ratingId         String
  rating           Rating               @relation(fields: [ratingId], references: [id], onDelete: Restrict)
  ratingRevision   Int
  revisionId       String
  reportedRevision RatingRevision       @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  reporterId       String
  reason           String
  explanation      String               @default("")
  status           String               @default("pending") // pending | kept | hidden
  version          Int                  @default(0)
  createdAt        DateTime             @default(now())
  decisions        ModerationDecision[]

  @@unique([ratingId, ratingRevision, reporterId])
  @@index([status, createdAt])
}

// Appended decisions keep restores and earlier resolutions explainable.
model ModerationDecision {
  id                  String         @id
  reportId            String
  report              RatingReport   @relation(fields: [reportId], references: [id], onDelete: Restrict)
  action              String // keep | hide | restore
  rationale           String
  moderatorId         String
  reviewedRevisionId  String
  reviewedRevision    RatingRevision @relation(fields: [reviewedRevisionId], references: [id], onDelete: Restrict)
  moderationVersion   Int
  resultingVisibility String
  previousVisibility  String
  createdAt           DateTime       @default(now())

  @@index([reportId, createdAt])
}

// Lease-end reminders (#10). Mutable per-lease settings of one recipient, kept apart from
// the signed Contract snapshot so editing them never amends the contract. `rulesJson`
// holds the reminder rules (stable id, daysBefore, local HH:MM, channels, enabled),
// validated in src/server/reminders/preferences.ts. `revision` guards stale edits.
model ReminderPreference {
  id          String   @id
  contractId  String
  recipientId String
  enabled     Boolean
  timeZone    String
  locale      String
  rulesJson   String
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([contractId, recipientId])
  @@index([recipientId])
}

// One logical reminder (lease, recipient, end-date version, rule, day offset). The unique
// logicalKey is the delivery ledger: a delivered occurrence is never sent again, even
// after a restart, a second worker or a clock-time edit.
// status: pending | covered | cancelled | skipped_past
model ReminderOccurrence {
  id                 String    @id
  logicalKey         String    @unique
  contractId         String
  recipientId        String
  eventVersion       String
  ruleId             String
  daysBefore         Int
  deadlineAt         DateTime
  dueAt              DateTime
  localDate          String
  localTime          String
  timeZone           String
  channelsJson       String
  preferenceRevision Int
  status             String
  attempts           Int       @default(0)
  lastAttemptAt      DateTime?
  nextAttemptAt      DateTime?
  lastErrorCode      String?
  claimToken         String?
  claimedUntil       DateTime?
  notificationId     String?
  coveredAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, dueAt])
  @@index([contractId, recipientId])
}

// A generated reminder or waiting-list message in one recipient's inbox. timingJson is the time
// left when it was generated; the inbox re-words the time left at viewing time from deadlineAt.
model Notification {
  id                 String                 @id
  recipientId        String
  /// The lease a lease_end_reminder is about; null for a waiting-list message.
  contractId         String?
  /// The waiting-list entry a waiting_list_still_wanted message is about; null otherwise.
  waitingListEntryId String?
  eventVersion       String
  kind               String // lease_end_reminder | waiting_list_still_wanted
  /// lease_end_reminder: the lease's exclusive end. waiting_list_still_wanted: the passed needed-by.
  endOn              String
  deadlineAt         DateTime
  originalDueAt      DateTime
  generatedAt        DateTime
  catchUp            Boolean
  timingJson         String
  payloadJson        String
  locale             String
  timeZone           String
  preferenceRevision Int
  coverages          ReminderCoverage[]
  deliveries         NotificationDelivery[]
  receipt            NotificationReceipt?

  @@index([recipientId, generatedAt])
}

// Which notification covered which occurrence on which channel. Unique per occurrence and
// channel, so the database itself refuses a duplicate delivery.
model ReminderCoverage {
  id             Int          @id @default(autoincrement())
  occurrenceId   String
  channel        String
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, channel])
}

// One channel artifact of a notification. mode is always "simulated": nothing is sent
// outside the app. status: recorded | skipped_missing_contact. Email rows keep the
// rendered preview (subject and text), never a claim of external delivery.
model NotificationDelivery {
  id             String       @id
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channel        String
  mode           String
  status         String
  locale         String
  toAddress      String?
  subject        String?
  bodyText       String?
  createdAt      DateTime

  @@unique([notificationId, channel])
}

// The recipient's own read state. Unread means not opened or marked read yet.
model NotificationReceipt {
  notificationId String       @id
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipientId    String
  readAt         DateTime?

  @@index([recipientId, readAt])
}

// A provider's grouping of physical items meant to be leased together. No prices: it only
// says which assets belong together and for which terms. Editing bumps `revision`.
model BundleOffer {
  id          String            @id
  providerId  String
  name        String
  description String
  /// Supported terms in months as JSON text, e.g. [24,36].
  terms_json  String
  published   Boolean           @default(false)
  revision    Int               @default(1)
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt
  items       BundleOfferItem[]

  @@index([providerId])
}

// One distinct physical asset in a bundle. An asset appears at most once per bundle.
model BundleOfferItem {
  offerId  String
  offer    BundleOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  assetId  String
  /// The provider's display order, starting at 0.
  position Int

  @@id([offerId, assetId])
  @@index([assetId])
}

// Provider-wide monthly rent promotions. Signed contract snapshots do not relate back
// to mutable rules, so later edits cannot change existing agreements or invoices.
model DiscountRule {
  archived      Boolean @default(false)
  id            String  @id
  providerId    String
  name          String
  minTermMonths Int
  maxTermMonths Int
  discountBps   Int
  enabled       Boolean
  revision      Int     @default(1)

  @@index([providerId])
}

// Remembered application answers (#51), so a user never has to give the same answer twice.
// One row per question in one profile set: `profileKey` is `consumer`, `sole_trader` or
// `company:<business id>` (src/domain/answer-scope.ts). `valueJson` is personal data: audit
// rows name the question only, never the value. `answeredOn` is the ISO day it was given.
model SavedAnswer {
  id         String   @id
  userId     String
  profileKey String
  questionId String
  valueJson  String
  answeredOn String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, profileKey, questionId])
  @@index([userId])
}
