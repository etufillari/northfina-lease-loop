# Copied to .env by `npm run db:setup` if .env does not exist. Never commit .env.
# SQLite file, relative to the repository root.
DATABASE_URL="file:./dev.db"

# Development company workspace: set a private password locally, then restart.
# LEASE_LOOP_OPERATOR_PASSWORD=

# Optional exact temporary tunnel hostname; omit https:// and the port.
# LEASE_LOOP_DEMO_HOST=
