# Copied to .env by `npm run db:setup` if .env does not exist. Never commit .env.
# SQLite file, relative to the repository root.
DATABASE_URL="file:./dev.db"

# Signs the "acting as" session token (src/server/session.ts). This placeholder is not a
# real secret and protects nothing; it only needs to be long and the same across restarts.
JWT_SECRET="dev-only-not-a-secret-change-me"
