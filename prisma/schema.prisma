// Database schema. Change it, then run `npm run db:migrate -- --name <what_changed>`.
// Never hand-write files in prisma/migrations/: the Prisma CLI generates them.
// SQLite has no enums here, so allowed values (category, condition, status) are
// checked with Zod in src/data/schemas.ts before anything is written.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One physical item that can be leased, returned, refurbished and leased again.
// Mirrors data/assets.json; `usage` is stored as two columns.
model Asset {
  id             String   @id
  category       String // e_bike | laptop | farm_machine
  make           String
  model          String
  model_year     Int
  serial_number  String   @unique
  condition      String // new | like_new | good | fair | poor
  usage_unit     String // km | battery_cycles | engine_hours
  usage_value    Int
  previous_lives Int
  status         String // available | reserved | returned
  reserved_until DateTime?
  reserved_by    String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  @@index([category])
}

// Who changed what, and when. Written in the same transaction as the change
// (see src/server/audit.ts), so a change without an audit row cannot exist.
model AuditLog {
  id           Int      @id @default(autoincrement())
  created_at   DateTime @default(now())
  actor        String
  action       String // e.g. asset.status_changed
  entity_type  String // e.g. asset
  entity_id    String
  details_json String? // JSON text, e.g. {"from":"available","to":"reserved"}

  @@index([entity_type, entity_id])
  @@index([created_at])
}

model Application {
  id                 String   @id
  customer_id        String
  asset_id           String
  start_date         String
  term_months        Int
  monthly_net_cents  Int
  payment_due_days   Int
  price_list_version Int
  offer_expires_on   String
  down_payment_cents Int @default(0)
  financed_cents Int @default(0)
  buyout_net_cents Int @default(0)
  circular_offer_id String?
  termination_policy String?
  status             String
  answers_json String @default("{}")
  decision_reason    String
  signing_authority  Boolean
  submitted_at       DateTime @default(now())
  signed_at          DateTime?
  contract           Contract?

  @@index([customer_id])
  @@index([asset_id])
  @@index([status])
}

model Contract {
  id                 String      @id
  application_id     String      @unique
  customer_id        String
  asset_id           String
  start_date         String
  term_months        Int
  monthly_net_cents  Int
  payment_due_days   Int
  price_list_version Int
  down_payment_cents Int @default(0)
  financed_cents Int @default(0)
  buyout_net_cents Int @default(0)
  circular_offer_id String?
  termination_policy String?
  signer_id          String
  signed_at          DateTime
  application        Application @relation(fields: [application_id], references: [id])

  @@index([customer_id])
  @@index([asset_id])
}

// Engine-owned signed terms. Contract/asset allocation is owned by the contract module.
model EngineLease {
  id                String @id
  contractId        String @unique
  assetId           String
  customerId        String
  startDate         String
  termMonths        Int
  monthlyNetCents   Int
  paymentDueDays    Int
  status            String
  terminatedOn      String?
  version           Int @default(1)
  invoices          EngineInvoice[]
  allocation        EngineAllocation?
  @@index([assetId])
}

// Issued rent amounts and tax snapshot are immutable; corrections need a separate credit.
model EngineInvoice {
  id              String @id
  number          String @unique
  leaseId         String
  lease           EngineLease @relation(fields: [leaseId], references: [id])
  periodIndex     Int
  issueDate       String
  dueDate         String
  endDateExclusive String
  netCents        Int
  vatCents        Int
  grossCents      Int
  taxJson         String
  status          String @default("ISSUED")
  issuedAt        DateTime @default(now())

  @@unique([leaseId, periodIndex])
}

model EngineInvoiceCounter {
  year Int @id
  last Int
}

// Serialized result supports an exact replay even if the aggregate later changes.
model EngineCommandReceipt {
  id            String @id
  actor         String
  operation     String
  key           String
  payloadHash   String
  resultJson    String

  @@unique([actor, operation, key])
}

// Exclusive live physical allocation. Completion retains it until circular release.
model EngineAllocation {
  assetId String @id
  leaseId String @unique
  lease EngineLease @relation(fields: [leaseId], references: [id])
}

// One receipt per actual lease, or a labeled imported return from the data pack.
model AssetReturn {
  id String @id
  assetId String
  leaseId String? @unique
  requestedOn String?
  receivedOn String?
  status String @default("RECEIVED")
  condition String?
  usageValue Int?
  planJson String?
  completedOn String?
  costCents Int?
  offerNetCents Int?
  reviewedOn String?
  reviewReason String?
  reviewedBy String?
  @@index([assetId])
}

// Immutable published asset-life quote, used instead of the original new-item list.
model CircularOffer {
  id String @id
  assetId String
  returnId String @unique
  netListCents Int
  publishedOn String
  @@index([assetId])
}

// Signed fee snapshot for buyout; zero defaults keep existing contracts readable.
model LeaseSettlement {
  leaseId String @id
  option String
  netCents Int
  vatCents Int
  grossCents Int
  effectiveOn String
  policyVersion String @default("EXIT_CAP_BUYOUT_V1")
}
