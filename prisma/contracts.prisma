// A signed contract: the lease terms locked at signing (CHALLENGE.md Spine #4).
// A price-list change after this row exists must never change its net rent or buyout —
// only the VAT on each invoice stays unlocked (see src/domain/invoicing.ts).
model Contract {
  id                     String   @id
  asset_id               String
  customer_id            String
  start_date             String // ISO YYYY-MM-DD; also invoice #1's invoice date
  term_months            Int
  price_list_version     Int
  list_price_cents       Int
  down_payment_cents     Int
  financed_cents         Int
  monthly_net_rent_cents Int
  buyout_cents           Int
  status                 String   @default("active") // pending_signature | active | bought | returned | extended
  // Set only while status is 'pending_signature' (CHALLENGE.md scenario card 6): the
  // company's named signatory, waiting to confirm before the contract (and its invoices)
  // actually start. See src/server/features/contracts/confirm-signature.ts.
  pending_signatory_email String?
  signed_at              DateTime @default(now())
  // The approved application this contract was formed from, and the name typed to sign it.
  // Unique, so one application can only ever become one contract. Both are null for a
  // contract that did not come from an application (an end-of-term extension).
  application_id         String?  @unique
  signed_name            String?

  @@index([asset_id])
  @@index([customer_id])
}

// A real invoice, issued once its invoice date arrives (CHALLENGE.md Spine #5). Unlike the
// full projected schedule src/domain/invoicing.ts can compute at any time, a row here only
// exists once that date has arrived — so its VAT rate is frozen at issuance, never recomputed.
// See src/server/features/contracts/issue-invoices.ts for how and when a row is created.
model Invoice {
  id               String    @id
  contract_id      String
  sequence_number  Int
  // rent (one per month of the term, numbered 1..term_months) | early_return_fee (at most one,
  // numbered term_months + 1 so it can never collide with a rent invoice).
  kind             String    @default("rent")
  // The day the invoice starts: it is issued and its VAT rate fixed. Payment is due on
  // payment_deadline. Keeps its old column name because a rename would drop the data.
  invoice_date     String    @map("due_date") // ISO YYYY-MM-DD
  payment_deadline String // ISO YYYY-MM-DD; invoice_date + the payment term (see src/domain/invoicing.ts)
  net_cents        Int
  vat_rate_percent Float
  vat_cents        Int
  gross_cents      Int
  status           String // issued | paid
  issued_at        DateTime  @default(now())
  paid_at          DateTime?

  @@unique([contract_id, sequence_number])
  @@index([contract_id])
}

// A ledger entry for a customer's credit balance: positive when earned (e.g. a pass_on
// bonus), negative when spent (applied as part of a down payment at signing). The balance
// is the sum of a customer's rows — see src/server/customer-credit.ts.
model CustomerCredit {
  id                  String   @id
  customer_id         String
  amount_cents        Int // positive = earned, negative = spent
  reason              String // e.g. pass_on_bonus | applied_to_down_payment
  related_contract_id String?
  created_at          DateTime @default(now())

  @@index([customer_id])
}
