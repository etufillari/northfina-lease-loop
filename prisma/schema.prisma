// Database configuration. Models live in auth.prisma, assets.prisma, contracts.prisma,
// application.prisma, customers.prisma and audit.prisma.
// Change the relevant model file, then run `npm run db:migrate -- --name <what_changed>`.
// Never hand-write files in prisma/migrations/: the Prisma CLI generates them.
// SQLite has no enums here, so allowed values (category, condition, status) are
// checked with Zod in src/data/schemas.ts before anything is written.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}
