# Copied to .env by `npm run db:setup` if .env does not exist. Never commit .env.
# SQLite file, relative to the repository root.
DATABASE_URL="file:./dev.db"

# Optional. Vercel sets this automatically for its own Cron Jobs; set it yourself only if
# you deploy to Vercel and want GET /api/system/issue-due-invoices to require it.
# CRON_SECRET=

# db:setup generates a random local secret. For production: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Production only: see README proxy and single-instance requirements.
# AUTH_TRUSTED_IP_HEADER=x-lease-loop-client-ip
# AUTH_SINGLE_INSTANCE=true
