// Database schema. Change it, then run `npm run db:migrate -- --name <what_changed>`.
// Never hand-write files in prisma/migrations/: the Prisma CLI generates them.
// SQLite has no enums here, so allowed values (category, condition, status) are
// checked with Zod in src/data/schemas.ts before anything is written.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One physical item that can be leased, returned, refurbished and leased again.
// Mirrors data/assets.json; `usage` is stored as two columns.
model Asset {
  id             String   @id
  category       String // e_bike | laptop | farm_machine
  make           String
  model          String
  model_year     Int
  serial_number  String   @unique
  condition      String // new | like_new | good | fair | poor
  usage_unit     String // km | battery_cycles | engine_hours
  usage_value    Int
  previous_lives Int
  status         String // available | reserved | returned
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@index([category])
}

// Who changed what, and when. Written in the same transaction as the change
// (see src/server/audit.ts), so a change without an audit row cannot exist.
model AuditLog {
  id           Int      @id @default(autoincrement())
  created_at   DateTime @default(now())
  actor        String
  action       String // e.g. asset.status_changed
  entity_type  String // e.g. asset
  entity_id    String
  details_json String? // JSON text, e.g. {"from":"available","to":"reserved"}

  @@index([entity_type, entity_id])
  @@index([created_at])
}

// A submitted lease application: the answers, the decision and a snapshot of the quoted
// price. The price is recalculated on the server, never taken from the browser, and stored
// with its price list version so a later contract can show which price was agreed.
model Application {
  id                  String   @id @default(uuid())
  created_at          DateTime @default(now())
  quote_date          String // YYYY-MM-DD the price was calculated on
  asset_id            String
  customer_type       String // consumer | sole_trader | company
  applicant_name      String?
  term_months         Int
  down_payment_cents  Int
  list_price_cents    Int
  price_list_version  Int
  financed_cents      Int
  monthly_net_cents   Int
  vat_basis_points    Int // 25.5 % → 2550, kept as an integer like money
  monthly_gross_cents Int
  decision            String // approved | rejected | manual_review
  reasons_json        String // JSON array of eligibility rule ids
  answers_json        String // JSON object: question id → answer

  @@index([asset_id])
}

// A signed lease contract. Every price field is COPIED from the approved application at
// signing and never recalculated, so later price lists can't change it. VAT is not stored:
// it is charged at the rate on each invoice's own date.
model Contract {
  id                 String   @id
  created_at         DateTime @default(now())
  application_id     String   @unique
  asset_id           String
  signed_date        String // YYYY-MM-DD
  signer_name        String
  customer_type      String
  customer_name      String
  customer_email     String?
  business_id        String?
  start_date         String // YYYY-MM-DD, the signing day
  end_date           String // YYYY-MM-DD, last day of the lease
  term_months        Int
  quote_date         String // when the locked price was calculated
  price_list_version Int
  list_price_cents   Int
  down_payment_cents Int
  financed_cents     Int
  monthly_net_cents  Int
  buyout_cents       Int
  status             String // active

  @@index([asset_id])
}
